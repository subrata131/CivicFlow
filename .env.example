# Default configuration uses the included SQLite database.
# Keep DATABASE_URL unset to use ./waterlogging_tracker.db
# To use MySQL instead, uncomment and update the next line:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/waterlogging_tracker

# Keep this value unchanged for compatibility with existing local demo tokens.
# For a fresh deployment, replace it with a long random secret and require users to log in again.
SECRET_KEY=CHANGE-THIS-SECRET-KEY-BEFORE-DEPLOYMENT-2026
